# =============================================================================
#  tanachok-web — ตัวอย่างการ build หน้าเว็บเป็นไฟล์นิ่งแล้วเสิร์ฟผ่าน nginx
#
#  จุดสำคัญ: production ไม่ใช้ Vite dev server
#    - ของจริงจะเป็น multi-stage: stage แรก `npm ci && vite build` -> dist/
#      stage สอง copy dist/ เข้า nginx
#    - ตัวอย่างนี้ยังไม่มี source ของหน้าเว็บจริง จึงใช้ไฟล์ใน docs/ แทน
#      เพื่อซ้อมสายงาน GitLab -> Jenkins -> รันเว็บ ให้ครบวงจรก่อน
#
#  Jenkins ของธนาคารไม่ต่ออินเทอร์เน็ต -> base image ต้องมาจาก Nexus
#    เปลี่ยนบรรทัด FROM เป็น ${NEXUS_REGISTRY}/nginx:1.27-alpine เมื่อใช้จริง
# =============================================================================
FROM nginx:1.27-alpine

ARG APP_VERSION=dev
ARG GIT_SHA=unknown
ENV APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA}

LABEL org.opencontainers.image.title="tanachok-web" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docs/ /usr/share/nginx/html/

# ฝัง version ลงใน image ให้ตรวจสอบได้จาก /version และจากหน้าจอ
RUN printf '{"app":"tanachok-web","version":"%s","commit":"%s"}\n' \
      "$APP_VERSION" "$GIT_SHA" > /usr/share/nginx/html/version.json \
 && cp /usr/share/nginx/html/tanachok-mockups.html /usr/share/nginx/html/index.html \
 && printf '%s' '<script>fetch("/version").then(r=>r.json()).then(v=>{var b=document.createElement("div");b.style.cssText="position:fixed;right:10px;bottom:10px;z-index:9999;background:#234D80;color:#fff;font:600 12px/1 Tahoma,sans-serif;padding:7px 12px;border-radius:999px;box-shadow:0 2px 8px rgba(0,0,0,.25)";b.textContent="version "+v.version+" ("+v.commit+")";document.body.appendChild(b)}).catch(function(){})</script>' \
      >> /usr/share/nginx/html/index.html

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -qO- http://localhost/healthz || exit 1
